<Application x:Class="NovelShelf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#F5F1E8"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFCF5"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#2A2118"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7A7066"/>
        <SolidColorBrush x:Key="Accent" Color="#426B5A"/>
    </Application.Resources>
</Application>

