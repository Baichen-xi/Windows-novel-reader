<Window x:Class="NovelShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovelShelf"
        Width="1180"
        Height="780"
        MinWidth="940"
        MinHeight="620"
        Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#426B5A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D7CBB9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#D7CBB9"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="94"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="#E1D8C9"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="NovelShelf"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="本地小说阅读器"
                               Margin="0,4,0,14"
                               Foreground="{StaticResource TextMuted}"/>
                    <Button Content="导入 TXT 小说" Click="ImportBook_Click"/>
                </StackPanel>

                <ListBox x:Name="BooksList"
                         Grid.Row="1"
                         DisplayMemberPath="Title"
                         SelectionChanged="BooksList_SelectionChanged"
                         Margin="0,12,0,14"/>

                <TextBlock Grid.Row="2"
                           Text="章节"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,2,0,8"/>

                <ListBox x:Name="ChaptersList"
                         Grid.Row="3"
                         DisplayMemberPath="Title"
                         SelectionChanged="ChaptersList_SelectionChanged"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="上一章" Click="PreviousChapter_Click"/>
                    <Button Content="下一章" Click="NextChapter_Click"/>
                    <Button Content="保存位置" Click="SavePosition_Click"/>
                    <Button Content="移除" Background="#8C4A3B" Click="RemoveBook_Click"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="还没有打开小说"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="MetaText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,16,0,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBox x:Name="SearchBox"
                             Width="220"
                             VerticalContentAlignment="Center"
                             ToolTip="输入关键词后搜索"/>
                    <Button Content="查找" Margin="8,0,8,0" Click="FindNext_Click"/>
                    <Button Content="上一个" Click="FindPrevious_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="字号"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="FontSizeSlider"
                            Width="130"
                            Minimum="14"
                            Maximum="32"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="FontSizeSlider_ValueChanged"/>
                    <ComboBox x:Name="ThemeComboBox"
                              Margin="14,0,0,0"
                              SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="纸张" Tag="Paper"/>
                        <ComboBoxItem Content="夜间" Tag="Dark"/>
                        <ComboBoxItem Content="护眼" Tag="Green"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>

            <Border x:Name="ReaderBorder"
                    Grid.Row="2"
                    Margin="0,20,0,14"
                    Padding="34,28"
                    Background="#FFFCF5"
                    BorderBrush="#E1D8C9"
                    BorderThickness="1">
                <TextBox x:Name="ReaderTextBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         Background="#FFFCF5"
                         BorderThickness="0"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="20"
                         Foreground="{StaticResource TextPrimary}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ReaderTextBox_SelectionChanged"/>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Foreground="{StaticResource TextMuted}"
                       Text="导入一本本地 TXT 文件开始阅读。"/>
        </Grid>
    </Grid>
</Window>
